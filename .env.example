# --- AI Readiness Assessment ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Cross-site URLs ---
NEXT_PUBLIC_CORPORATE_URL=https://endedge.co
NEXT_PUBLIC_PORTAL_URL=https://live.endedge.co

# --- UAE trust signals (footer + contact) — required for trust block ---
NEXT_PUBLIC_COMPANY_STREET_ADDRESS=
NEXT_PUBLIC_COMPANY_TRADE_LICENSE=
NEXT_PUBLIC_COMPANY_TRN=
NEXT_PUBLIC_COMPANY_PHONE=
# WhatsApp Business number, digits only with country code (e.g. 971501234567)
NEXT_PUBLIC_COMPANY_WHATSAPP=

# --- Analytics & Search Console ---
# GA4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta tag content from Google Search Console verification
GOOGLE_SITE_VERIFICATION=

# --- Checklist lead capture ---
# POST JSON payload on successful form submit (Zapier, Make, CRM, etc.)
CHECKLIST_LEAD_WEBHOOK_URL=
# Optional header value sent as X-Webhook-Secret
CHECKLIST_LEAD_WEBHOOK_SECRET=
