# --- AI Readiness Assessment ---
# Optional. If unset, the assessment returns a high-quality deterministic report,
# so the site works out of the box. Set this to enable AI-generated, tailored reports.
ANTHROPIC_API_KEY=

# Optional. Override the model used for the readiness report.
# Defaults to "claude-sonnet-5". Set to whatever your account has access to
# (e.g. a Haiku-class model for lower cost/latency).
ANTHROPIC_MODEL=claude-sonnet-5
